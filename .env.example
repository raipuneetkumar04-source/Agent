# ==============================================================================
# Verification Coverage Analyzer - Configuration
# ==============================================================================

# LLM Provider selection: auto | openai | anthropic | gemini | ollama | offline
# Default 'auto' automatically detects available keys and falls back to offline expert mode.
LLM_PROVIDER=auto

# Optional: Default Model Name
# Google Gemini Configuration
# GEMINI_API_KEY: Your Google Gemini API Key
GEMINI_API_KEY=
# LLM_PROVIDER: Set to gemini to use Google Gemini
LLM_PROVIDER=gemini
# LLM_MODEL: Model identifier (e.g., gemini-f3.5-flash-latest, gemini-3.5-flash, gemini-flash-latest)
LLM_MODEL=gemini-f3.5-flash-latest
# GEMINI_RPM: Rate limit in requests per minute (default 30 RPM = 2.0s interval)
GEMINI_RPM=30

# OpenAI API Key (optional)
OPENAI_API_KEY=

# Anthropic Claude API Key (optional)
ANTHROPIC_API_KEY=

# Local Ollama URL (optional, default http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

